{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "eu-west-1",
        "profile": "lw-employee-ai"
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.8-27b-mlx-4k": {
          "name": "qwen3.8 (4k)",
          "limit": {
            "context": 4096,
            "output": 1024
          }
        },
        "qwen3.8-27b-mlx-8k": {
          "name": "qwen3.8 (8k)",
          "limit": {
            "context": 8192,
            "output": 2048
          }
        },
        "qwen3.8-27b-mlx-16k": {
          "name": "qwen3.8 (16k)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "qwen3.8-27b-mlx-32k": {
          "name": "qwen3.8 (32k)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3.8-27b-mlx-256k": {
          "name": "qwen3.8 (256k)",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        }
      }
    }
  },
  "lsp": {
    "go": {
      "disabled": true
    }
  },
  "mcp": {
    "gopls": {
      "enabled": true,
      "type": "local",
      "command": ["gopls", "mcp"]
    },
    "linear": {
      "enabled": true,
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"]
    },
    "sourcegraph": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://lunar.sourcegraph.com/.api/mcp"
      ]
    }
  }
}
